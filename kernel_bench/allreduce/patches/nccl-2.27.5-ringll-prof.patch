+ *
+ * See LICENSE.txt for license information
+ ************************************************************************/
+
+#ifndef NCCL_LL_PROF_H_
+#define NCCL_LL_PROF_H_
+
+enum ncclLlProfCounter {
+  ncclLlProfGenericCycles = 0,
+  ncclLlProfGenericCalls,
+  ncclLlProfWaitSendCycles,
+  ncclLlProfWaitSendCalls,
+  ncclLlProfWaitSendPolls,
+  ncclLlProfReadCycles,
+  ncclLlProfReadCalls,
+  ncclLlProfReadPolls,
+  ncclLlProfStoreCycles,
+  ncclLlProfStoreCalls,
+  ncclLlProfBarrierCycles,
+  ncclLlProfBarrierCalls,
+  ncclLlProfCounterCount
+};
+
+extern __device__ unsigned long long ncclLlProfCounters[ncclLlProfCounterCount];
+
+__device__ __forceinline__ void ncclLlProfAdd(int index, unsigned long long value) {
+  if (value != 0) atomicAdd(&ncclLlProfCounters[index], value);
+}
+
+#endif
diff --git a/src/device/common.cu b/src/device/common.cu
index a8b5ed5..5155c6f 100644
--- a/src/device/common.cu
+++ b/src/device/common.cu
@@ -9,0 +10,3 @@
+#include "ll_prof.h"
+#include <cuda_runtime.h>
+#include <stdio.h>
@@ -15,0 +19,72 @@ __shared__ ncclShmemData ncclShmem;
+__device__ unsigned long long ncclLlProfCounters[ncclLlProfCounterCount];
+
+static const char* ncclLlProfName(int i) {
+  switch (i) {
+  case ncclLlProfGenericCycles: return "generic_cycles";
+  case ncclLlProfGenericCalls: return "generic_calls";
+  case ncclLlProfWaitSendCycles: return "waitSend_cycles";
+  case ncclLlProfWaitSendCalls: return "waitSend_calls";
+  case ncclLlProfWaitSendPolls: return "waitSend_polls";
+  case ncclLlProfReadCycles: return "readLL_cycles";
+  case ncclLlProfReadCalls: return "readLL_calls";
+  case ncclLlProfReadPolls: return "readLL_polls";
+  case ncclLlProfStoreCycles: return "storeLL_cycles";
+  case ncclLlProfStoreCalls: return "storeLL_calls";
+  case ncclLlProfBarrierCycles: return "barrier_cycles";
+  case ncclLlProfBarrierCalls: return "barrier_calls";
+  default: return "unknown";
+  }
+}
+
+extern "C" __attribute__((visibility("default"))) int ncclLlProfResetAll(int ndevs, const int* devs) {
+  unsigned long long zero[ncclLlProfCounterCount] = {};
+  for (int i = 0; i < ndevs; i++) {
+    cudaError_t err = cudaSetDevice(devs[i]);
+    if (err != cudaSuccess) return (int)err;
+    err = cudaMemcpyToSymbol(ncclLlProfCounters, zero, sizeof(zero));
+    if (err != cudaSuccess) return (int)err;
+  }
+  return 0;
+}
+
+extern "C" __attribute__((visibility("default"))) int ncclLlProfDumpAll(int ndevs, const int* devs, const char* tag) {
+  unsigned long long total[ncclLlProfCounterCount] = {};
+  for (int d = 0; d < ndevs; d++) {
+    unsigned long long one[ncclLlProfCounterCount] = {};
+    cudaError_t err = cudaSetDevice(devs[d]);
+    if (err != cudaSuccess) return (int)err;
+    err = cudaMemcpyFromSymbol(one, ncclLlProfCounters, sizeof(one));
+    if (err != cudaSuccess) return (int)err;
+    for (int i = 0; i < ncclLlProfCounterCount; i++) total[i] += one[i];
+  }
+
+  unsigned long long generic = total[ncclLlProfGenericCycles];
+  unsigned long long known =
+      total[ncclLlProfWaitSendCycles] + total[ncclLlProfReadCycles] +
+      total[ncclLlProfStoreCycles] + total[ncclLlProfBarrierCycles];
+  long long other = (long long)generic - (long long)known;
+
+  fprintf(stderr, "\nNCCL_LL_PROF tag=%s devices=%d\n", tag ? tag : "", ndevs);
+  for (int i = 0; i < ncclLlProfCounterCount; i++) {
+    fprintf(stderr, "  %-18s %llu\n", ncclLlProfName(i), total[i]);
+  }
+  if (generic != 0) {
+    fprintf(stderr,
+            "  phase_pct_vs_generic waitSend=%.2f readLL=%.2f storeLL=%.2f barrier=%.2f other=%.2f\n",
+            100.0 * (double)total[ncclLlProfWaitSendCycles] / (double)generic,
+            100.0 * (double)total[ncclLlProfReadCycles] / (double)generic,
+            100.0 * (double)total[ncclLlProfStoreCycles] / (double)generic,
+            100.0 * (double)total[ncclLlProfBarrierCycles] / (double)generic,
+            100.0 * (double)other / (double)generic);
+  }
+  if (total[ncclLlProfReadCalls] != 0) {
+    fprintf(stderr, "  avg_readLL_polls_per_call %.3f\n",
+            (double)total[ncclLlProfReadPolls] / (double)total[ncclLlProfReadCalls]);
+  }
+  if (total[ncclLlProfWaitSendCalls] != 0) {
+    fprintf(stderr, "  avg_waitSend_polls_per_call %.3f\n",
+            (double)total[ncclLlProfWaitSendPolls] / (double)total[ncclLlProfWaitSendCalls]);
+  }
+  return 0;
+}
+
